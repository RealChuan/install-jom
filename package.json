{
    "name": "install-jom",
    "version": "0.0.1",
    "private": true,
    "description": "GitHub Action to install JOM",
    "main": "src/main.js",
    "engines": {
        "node": ">=22.20.0"
    },
    "scripts": {
        "build": "ncc build src/main.js -o dist --license licenses.txt",
        "package": "npm run build && git add dist/",
        "lint": "eslint src/main.js",
        "fix": "eslint src/main.js --fix"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RealChuan/install-jom.git"
    },
    "author": "RealChuan",
    "license": "GPL-3.0-only",
    "keywords": [
        "github-actions",
        "jom",
        "qt",
        "build-tool",
        "windows"
    ],
    "devDependencies": {
        "@vercel/ncc": "^0.38.4"
    },
    "dependencies": {
        "@actions/cache": "^4.1.0",
        "@actions/core": "^1.11.1",
        "@actions/exec": "^1.1.1",
        "@actions/io": "^1.1.3",
        "@actions/tool-cache": "^2.0.2"
    }
}
